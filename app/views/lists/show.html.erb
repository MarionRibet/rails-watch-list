<h1><%= @list.name %></h1>

<% @list.movies.each do |movie| %>
  <%= movie.title %>
  <%# <%= movie.rating %>
  <% bookmark = Bookmark.find_by(movie_id: movie.id, list_id: @list) %>
  <%= bookmark.comment %>
  <%= link_to "Delete", bookmark_path(bookmark), data: {
    turbo_method: :delete,
    turbo_confirm: "Are you sure?"
  } %>
<% end %>
<%= link_to "Back to My lists", lists_path %>

<%= link_to "Add a movie", new_list_bookmark_path(@list) %>
